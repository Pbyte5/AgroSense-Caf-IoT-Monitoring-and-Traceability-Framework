# ==============================================================================
# AgroSense Café — Local Development Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & API Configuration (FastAPI)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="AgroSense Cafe API"
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=DEBUG
SECRET_KEY=dev_secret_key_change_in_production_32bytes_min

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / psql)
# ------------------------------------------------------------------------------
POSTGRES_DB=agrosense_db
POSTGRES_USER=agrosense_user
POSTGRES_PASSWORD=agrosense_pass_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Connection string used by Alembic & SQLAlchemy
DATABASE_URL=postgresql://agrosense_user:agrosense_pass_dev@postgres:5432/agrosense_db

# ------------------------------------------------------------------------------
# 3. Message Broker Configuration (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=agrosense
RABBITMQ_DEFAULT_PASS=agrosense_mq_dev
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# AMQP connection URL
RABBITMQ_URL=amqp://agrosense:agrosense_mq_dev@rabbitmq:5672/

# ------------------------------------------------------------------------------
# 4. Storage & Data Lake Configuration (LocalStack / S3 Medallion)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# Endpoint for LocalStack inside Docker network
AWS_ENDPOINT_URL=http://localstack:4566
# Data Lake Medallion Bucket Names
S3_BUCKET_BRONZE=agrosense-bronze
S3_BUCKET_SILVER=agrosense-silver
S3_BUCKET_GOLD=agrosense-gold
S3_BUCKET_BACKUPS=agrosense-backups

# ------------------------------------------------------------------------------
# 5. Synthetic Data Seed Engine & Reproducibility Controls
# ------------------------------------------------------------------------------
# Dataset scale profile: 'dev' (1/10 scale, ~130 farms) or 'prod' (1,300 farms)
SEED_PROFILE=dev
# Fixed PRNG state for 100% deterministic generation
SEED_RANDOM_STATE=42
# Global defect injection rate (0.05 = 5% anomalies)
SEED_DEFECT_GLOBAL_RATE=0.05
# Enforce deterministic UUIDv5 identifiers
SEED_REPRODUCIBLE=true
